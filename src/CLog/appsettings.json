{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "CLog": {
    "Seq": {
      "Url": "http://localhost:5341",
      "ApiKey": "",
      "Filter": null,
      "MaxEvents": 200
    },
    "Ollama": {
      "Url": "http://localhost:11434",
      "Model": "mistral",
      "TimeoutSeconds": 120
    },
    "Triage": {
      "Mode": "TwoStep",
      "KnownPrompt": "Beskriver kunskapsbasen nedan exakt detta fel? Svara ENDAST Ja eller Nej.\n\n# Kunskapsbas\n{knowledge}\n\n# Fel\n{error}",
      "NoisePrompt": "Är detta ett misslyckat anrop utifrån — fel API-nyckel, 401/404, avbruten begäran — snarare än ett fel i vår kod? Svara ENDAST Ja eller Nej.\n\n# Fel\n{error}"
    },
    "IntervalMinutes": 5,
    "MaxJudgementsPerRun": 10,
    "LookbackMinutes": 10,
    "KnowledgeFile": "knowledge/known-errors.md",
    "RulesFile": "knowledge/rules.json",
    "DatabasePath": "data/clog.db",
    "TriageLogPath": "data/triage.jsonl"
  }
}
